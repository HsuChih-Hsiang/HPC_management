# ============================================================
# 正式機的 .env 範本
#
# 這個檔案是進版控的「範本」，真正的 .env 不會、也不該進 git。
# 部署時把它複製到 VM 上的固定位置（預設 /srv/hpcemail/.env）並填入實際值，
# CI 每次部署會把它複製進 workspace 根目錄給 docker compose 使用。
#
#     sudo mkdir -p /srv/hpcemail
#     sudo cp deployment/.env.example /srv/hpcemail/.env
#     sudo chmod 600 /srv/hpcemail/.env
#     sudo vi /srv/hpcemail/.env
#
# 注意：值裡若含有 # 或空白，請用雙引號包起來。
# ============================================================

# --- 資料庫 ---
# 資料庫在容器外面，位址請用實際 IP 或主機名，不要用 localhost
# （容器裡的 localhost 是容器自己）。
DATABASE_URI="postgresql://<user>:<password>@140.112.8.36/hpc"

# --- Flask ---
# 128 字元隨機字串。同時是 Fernet 加密金鑰的來源（utils/crypto_utils.py），
# 【換掉這個值，資料庫裡已加密的 SMTP 密碼就再也解不開】。
SECRET_KEY="<128 字元隨機字串>"

# --- 反向代理 ---
# WAF -> nginx -> gunicorn。docker-compose.yml 已經設好 BEHIND_PROXY=true，
# 這裡只在需要微調時才覆寫。
# 若 WAF 不會往 X-Forwarded-For append，把 PROXY_X_FOR 改成 1。
# PROXY_X_FOR=2

# --- 自簽憑證的 CN，同時是對外服務網域 ---
DOMAIN="hpc.example.edu.tw"

# --- Google OAuth ---
# Google Cloud Console 的「已授權的重新導向 URI」必須填：
#     https://${DOMAIN}/callback
GOOGLE_CLIENT_ID="<client id>"
GOOGLE_CLIENT_SECRET="<client secret>"

# --- SMTP 退路設定 ---
# 正式來源是資料庫的「設定」頁面；這裡只是資料庫尚未設定時的預設值，可留空。
SMTP_SERVER=""
SMTP_PORT=""

# 舊版 Dockerfile 曾經用 GITHUB_TOKEN 在 build 期間 clone 程式碼，
# 現在改由 CI checkout 後直接當 build context，已不再需要這個變數。
